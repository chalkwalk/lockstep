[submodule "JUCE"]
	path = JUCE
	url = https://github.com/juce-framework/JUCE.git
	ignore = dirty
[submodule "modules/clap-juce-extensions"]
	path = modules/clap-juce-extensions
	url = https://github.com/free-audio/clap-juce-extensions.git
[submodule "modules/bungee"]
	path = modules/bungee
	url = https://github.com/bungee-audio-stretch/bungee.git
[submodule "modules/signalsmith-dsp"]
	path = modules/signalsmith-dsp
	url = https://github.com/Signalsmith-Audio/dsp.git
[submodule "modules/fluidlite"]
	path = modules/fluidlite
	url = https://github.com/divideconcept/FluidLite.git
	# Patched in place at configure time (patches/fluidlite-sf3-loop-offbyone.patch),
	# so a working tree here is EXPECTED to be dirty.
	ignore = dirty
