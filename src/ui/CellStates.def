// CellStates.def — X-macro table of every CellState token.
//
// Usage: define LS_CELLSTATE(token, value, screenFill, screenAccent, pushPad, xtouchVel)
//        then #include this file, then #undef LS_CELLSTATE.
//
// Columns:
//   token       — CellState enum name (no namespace)
//   value       — numeric value (add-only; never renumber)
//   screenFill  — ARGB uint32; base fill colour used by screen renderers
//   screenAccent— ARGB uint32; accent / overlay colour (0 = none defined)
//   pushPad     — uint8; Push 1 firmware palette index (pidx::k* literals)
//   xtouchVel   — uint8; X-Touch Mini LED velocity: 0=off 1=flash 127=solid
//
// Derived from:
//   - SurfaceModel.cpp  compatColour()      → screenFill
//   - Push1Surface.cpp  stepGridIndex()     → pushPad
//   - XTouchMiniSurface.cpp cellStateToVelocity() → xtouchVel

// ---- key family -------------------------------------------------------
LS_CELLSTATE(Resting,            0,  0xFF2D3741u, 0x00000000u,  71,   0)
LS_CELLSTATE(Pressed,            1,  0xFFFFFFFFu, 0x00000000u, 119, 127)
LS_CELLSTATE(ModeActive,         2,  0xFF8898A8u, 0x00000000u,   2, 127)
LS_CELLSTATE(FuncHeld,           3,  0xFFC07800u, 0x00000000u,   9,   0)
LS_CELLSTATE(Disabled,           4,  0xFF1A1A1Au, 0x00000000u,   0,   0)
// Modal-entry key exists and is reachable but currently has no enabled content.
// Rendered as dim amber to signal "configurable here, nothing active yet".
LS_CELLSTATE(ModalEntryInert,    5,  0xFF3A2400u, 0x00000000u,  61,   0)

